# Walking-route OSRM endpoint used by the directions feature.
#
# Default (omit this var): https://router.project-osrm.org/route/v1
#   The public OSRM demo. Free, but rate-limited and frequently 503s.
#   FINE for local dev. NOT for production.
#
# Production options:
#   1. Self-hosted OSRM in Docker with a Luzon foot-profile extract
#      (osrm-backend image + osrm-extract / osrm-contract pipeline).
#      Cheapest option (~$5/mo on Fly.io / Hetzner).
#   2. Stadia Maps OSRM-compatible routing (sign up, free tier).
#   3. MapTiler Routing API (sign up, free tier with key in URL).
#
# The endpoint must implement the OSRM /route/v1 spec — including
# `profile=walking` (or `foot`, depending on your build).
NEXT_PUBLIC_OSRM_URL=https://router.project-osrm.org/route/v1

# --- Supabase (building photos) ---
# Public — safe to ship to the browser. Reads / anonymous inserts only.
NEXT_PUBLIC_SUPABASE_URL=https://hqjqzbddxfqlnzcylcpu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_aIPmedH-Pwllm0b-Nl_1kA_j69iPkfJ
NEXT_PUBLIC_SUPABASE_BUCKET=up-building-photos

# Server-only — never expose. Used by /api/admin/* to approve/reject photos.
# Get the service-role key from Supabase Dashboard → Project Settings → API.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the dev types into /admin to authenticate.
# Pick anything strong (e.g. `openssl rand -hex 32`).
ADMIN_TOKEN=
